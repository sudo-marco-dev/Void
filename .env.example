# Portfolio Monorepo Environment Variables
# Initial Day-1 deployment of the public portfolio requires NO environment variables
# (layout.tsx, robots.ts, and sitemap.ts automatically detect VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL).
#
# Optional overrides for local testing or custom domains:
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional for future client modules (Phase 6+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
